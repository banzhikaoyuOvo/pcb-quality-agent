# 逐层解锁到 best.pt
fastapi-app/runs/*
!fastapi-app/runs/detect/
fastapi-app/runs/detect/*
!fastapi-app/runs/detect/runs/
fastapi-app/runs/detect/runs/*
!fastapi-app/runs/detect/runs/pcb_detect/
