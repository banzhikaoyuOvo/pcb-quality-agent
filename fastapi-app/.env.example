# ==========================================
# 智能制造质检多 Agent 协同平台 - 环境变量模板
# ==========================================


# --- AI 模型配置 ---
# DeepSeek API Key（用于 RootCause Agent 根因推理）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# YOLOv8 模型权重路径
MODEL_PATH=runs/detect/runs/pcb_detect/train_v1/weights/best.pt

# LLM API Base URL
LLM_BASE_URL=https://api.deepseek.com

# LLM Model Name
LLM_MODEL=deepseek-chat

# Milvus Lite 数据库文件路径
MILVUS_DB_PATH=milvus_data.db

# --- 可选：LangSmith 追踪（生产建议关闭）---
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_pt_xxx
# LANGCHAIN_PROJECT=pcb-quality-agent